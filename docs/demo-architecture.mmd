flowchart LR
    User(["Business user<br/>Natural-language question"])
    Analyst(["Report consumer<br/>Dashboard"])

    subgraph WE["West Europe - Foundry VNet 10.100.0.0/16"]
        direction TB
        Agent["Microsoft Foundry agent<br/>genie-agent:1"]
        Model["GPT-4.1-mini"]
        Connection["Project connection<br/>databricks-genie-mcp"]
        Agent --> Model
        Agent --> Connection
    end

    subgraph NE["North Europe - Databricks VNet 10.200.0.0/16"]
        direction TB
        PrivateEndpoint["Private endpoint<br/>and private DNS"]
        MCP["Genie MCP endpoint"]
        Genie["Genie space<br/>Sales and Customer Analytics"]
        Warehouse["genie-warehouse<br/>SQL warehouse"]
        Views[("Shared metric views<br/>sales_kpi + sales_analytics")]
        Tables[("&lt;catalog&gt;.sales<br/>fact_sales + dimensions")]
        PrivateEndpoint --> MCP --> Genie --> Warehouse --> Views --> Tables
    end

    subgraph RPT["Reporting - requires private network access"]
        direction TB
        PowerBI["Power BI semantic model<br/>DirectQuery"]
    end

    subgraph ADM["Administration"]
        direction TB
        Administrator(["Administrator"])
        Bastion["Azure Bastion"]
        Jumpbox["Jumpbox VM"]
        Administrator --> Bastion --> Jumpbox
    end

    User -->|"1. Ask"| Agent
    Connection -->|"2. Authenticated MCP call<br/>over VNet peering"| PrivateEndpoint
    Views -->|"3. Grounded values"| Agent
    Agent -->|"4. Plain-language answer"| User

    Views -->|"Same metric definitions"| PowerBI
    PowerBI --> Analyst

    Jumpbox -.->|"Setup only"| Agent
    Jumpbox -.->|"Bootstrap only"| Warehouse

    classDef user fill:#E1F5FE,stroke:#0078D4,stroke-width:2px,color:#000;
    classDef foundry fill:#DFF6DD,stroke:#107C10,stroke-width:2px,color:#000;
    classDef databricks fill:#FFF4CE,stroke:#F7630C,stroke-width:2px,color:#000;
    classDef shared fill:#FFE0B2,stroke:#C43E00,stroke-width:3px,color:#000;
    classDef reporting fill:#FDE7E9,stroke:#C50F1F,stroke-width:2px,color:#000;
    classDef admin fill:#F3F2F1,stroke:#605E5C,stroke-width:2px,color:#000;
    class User,Analyst user;
    class Agent,Model,Connection foundry;
    class PrivateEndpoint,MCP,Genie,Warehouse,Tables databricks;
    class Views shared;
    class PowerBI reporting;
    class Administrator,Bastion,Jumpbox admin;
