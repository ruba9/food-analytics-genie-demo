/// Databricks SQL warehouse server hostname, for example adb-0000000000000000.0.azuredatabricks.net
expression ServerHostname = "replace-with-workspace-host" meta [IsParameterQuery=true, Type="Text", IsParameterQueryRequired=true]
	lineageTag: 6f1c0c2a-41b7-4f0e-9a21-6e3f2d5c8a01

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Text

/// HTTP path of the Databricks SQL warehouse, for example /sql/1.0/warehouses/abcdef1234567890
expression HttpPath = "replace-with-warehouse-http-path" meta [IsParameterQuery=true, Type="Text", IsParameterQueryRequired=true]
	lineageTag: 6f1c0c2a-41b7-4f0e-9a21-6e3f2d5c8a02

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Text

/// Unity Catalog catalog holding the sales schema. Must match the catalog used by databricks/bootstrap.ps1.
expression CatalogName = "food_analytics" meta [IsParameterQuery=true, Type="Text", IsParameterQueryRequired=true]
	lineageTag: 6f1c0c2a-41b7-4f0e-9a21-6e3f2d5c8a03

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Text

expression SchemaName = "sales" meta [IsParameterQuery=true, Type="Text", IsParameterQueryRequired=true]
	lineageTag: 6f1c0c2a-41b7-4f0e-9a21-6e3f2d5c8a04

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Text
