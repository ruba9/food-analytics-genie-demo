/// Databricks SQL warehouse hostname. deployment/push-powerbi-to-jumpbox.ps1 fills this from environment.json; when opening the project directly, set it in Transform data > Edit parameters.
expression ServerHostname = "<databricks-host>" meta [IsParameterQuery=true, Type="Text", IsParameterQueryRequired=true]
	lineageTag: 8a1c4e20-1111-4a10-9d30-0c2b5f7a0001

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Text

/// HTTP path of the Databricks SQL warehouse.
expression HttpPath = "/sql/1.0/warehouses/<sql-warehouse-id>" meta [IsParameterQuery=true, Type="Text", IsParameterQueryRequired=true]
	lineageTag: 8a1c4e20-1111-4a10-9d30-0c2b5f7a0002

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Text

/// Unity Catalog catalog holding the shared views.
expression CatalogName = "food_analytics" meta [IsParameterQuery=true, Type="Text", IsParameterQueryRequired=true]
	lineageTag: 8a1c4e20-1111-4a10-9d30-0c2b5f7a0003

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Text

/// Schema holding sales_analytics, waste_analytics and sales_kpi.
expression SchemaName = "gold" meta [IsParameterQuery=true, Type="Text", IsParameterQueryRequired=true]
	lineageTag: 8a1c4e20-1111-4a10-9d30-0c2b5f7a0004

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Text
