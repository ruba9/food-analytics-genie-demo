table 'Sales Analytics'
	lineageTag: 3c9d1a40-2222-4b21-8e42-1d3c6a8b0100

	/// Net revenue after discounts, in SEK. This measure is the metric definition; the
	/// Databricks view supplies only the additive column it sums.
	measure 'Net Revenue' = SUM('Sales Analytics'[net_revenue])
		formatString: #,0.00 "SEK"
		lineageTag: 3c9d1a40-2222-4b21-8e42-1d3c6a8b0110

	measure 'Gross Revenue' = SUM('Sales Analytics'[gross_revenue])
		formatString: #,0.00 "SEK"
		lineageTag: 3c9d1a40-2222-4b21-8e42-1d3c6a8b0111

	measure 'Discount Amount' = SUM('Sales Analytics'[discount_amount])
		formatString: #,0.00 "SEK"
		lineageTag: 3c9d1a40-2222-4b21-8e42-1d3c6a8b0112

	measure 'Cost of Goods' = SUM('Sales Analytics'[cost_of_goods])
		formatString: #,0.00 "SEK"
		lineageTag: 3c9d1a40-2222-4b21-8e42-1d3c6a8b0113

	measure 'Gross Margin' = SUM('Sales Analytics'[gross_margin])
		formatString: #,0.00 "SEK"
		lineageTag: 3c9d1a40-2222-4b21-8e42-1d3c6a8b0114

	/// Ratio of summed margin to summed revenue, never an average of row percentages.
	measure 'Gross Margin %' = DIVIDE([Gross Margin], [Net Revenue])
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 3c9d1a40-2222-4b21-8e42-1d3c6a8b0115

	measure 'Units Sold' = SUM('Sales Analytics'[units_sold])
		formatString: #,0
		lineageTag: 3c9d1a40-2222-4b21-8e42-1d3c6a8b0116

