table 'Sales Analytics'
	lineageTag: 2b7d9e10-5c44-4a3e-9b6d-0f1a7c4e5d10

	measure 'Sales Volume (kg)' = SUM('Sales Analytics'[sales_volume_kg])
		formatString: #,0.0
		lineageTag: 2b7d9e10-5c44-4a3e-9b6d-0f1a7c4e5d20

	measure 'Revenue (EUR)' = SUM('Sales Analytics'[revenue_eur])
		formatString: \€#,0.00;(\€#,0.00);\€#,0.00
		lineageTag: 2b7d9e10-5c44-4a3e-9b6d-0f1a7c4e5d21

	measure 'Cost (EUR)' = SUM('Sales Analytics'[cost_eur])
		formatString: \€#,0.00;(\€#,0.00);\€#,0.00
		lineageTag: 2b7d9e10-5c44-4a3e-9b6d-0f1a7c4e5d22

	measure 'Gross Margin (EUR)' = SUM('Sales Analytics'[gross_margin_eur])
		formatString: \€#,0.00;(\€#,0.00);\€#,0.00
		lineageTag: 2b7d9e10-5c44-4a3e-9b6d-0f1a7c4e5d23

	measure 'Gross Margin %' = DIVIDE([Gross Margin (EUR)], [Revenue (EUR)])
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 2b7d9e10-5c44-4a3e-9b6d-0f1a7c4e5d24

	measure 'Order Lines' = SUM('Sales Analytics'[order_line_count])
		formatString: #,0
		lineageTag: 2b7d9e10-5c44-4a3e-9b6d-0f1a7c4e5d25

