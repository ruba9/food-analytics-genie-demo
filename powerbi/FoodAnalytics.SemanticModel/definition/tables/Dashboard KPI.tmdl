/// Databricks-side KPI values, imported for comparison only.
///
/// The DAX measures in Sales Analytics and Waste Analytics are the metric definitions.
/// This table exists so a demo can show the Databricks figure next to the Power BI one:
/// with an imported model they diverge whenever the refresh is stale, which is the point
/// worth making, not a defect.
table 'Dashboard KPI'
	lineageTag: 5e1f3c60-4444-4d43-8a64-3f5e8cad0100

	measure 'Databricks KPI Value' = SUM('Dashboard KPI'[metric_value])
		formatString: #,0.00
		lineageTag: 5e1f3c60-4444-4d43-8a64-3f5e8cad0110

	column metric_name
		dataType: string
		lineageTag: 5e1f3c60-4444-4d43-8a64-3f5e8cad0200
		summarizeBy: none
		sourceColumn: metric_name

		annotation SummarizationSetBy = Automatic

	column metric_value
		dataType: decimal
		lineageTag: 5e1f3c60-4444-4d43-8a64-3f5e8cad0201
		summarizeBy: none
		sourceColumn: metric_value

		annotation SummarizationSetBy = Automatic

	column metric_unit
		dataType: string
		lineageTag: 5e1f3c60-4444-4d43-8a64-3f5e8cad0202
		summarizeBy: none
		sourceColumn: metric_unit

		annotation SummarizationSetBy = Automatic

	partition 'Dashboard KPI' = m
		mode: import
		source =
				let
				    Source = Databricks.Catalogs(ServerHostname, HttpPath, [Catalog=null, Database=null, EnableAutomaticProxyDiscovery=null]),
				    Catalog = Source{[Name=CatalogName,Kind="Database"]}[Data],
				    Schema = Catalog{[Name=SchemaName,Kind="Schema"]}[Data],
				    View = Schema{[Name="sales_kpi",Kind="View"]}[Data]
				in
				    View

	annotation PBI_ResultType = Table
