		lineageTag: 4d0e2b50-3333-4c32-9f53-2e4d7b9c0203
		summarizeBy: none
		sourceColumn: product_name

		annotation SummarizationSetBy = Automatic

	column category
		dataType: string
		lineageTag: 4d0e2b50-3333-4c32-9f53-2e4d7b9c0204
		summarizeBy: none
		sourceColumn: category

		annotation SummarizationSetBy = Automatic

	column region
		dataType: string
		lineageTag: 4d0e2b50-3333-4c32-9f53-2e4d7b9c0205
		summarizeBy: none
		sourceColumn: region

		annotation SummarizationSetBy = Automatic

	column store_name
		dataType: string
		lineageTag: 4d0e2b50-3333-4c32-9f53-2e4d7b9c0206
		summarizeBy: none
		sourceColumn: store_name

		annotation SummarizationSetBy = Automatic

	column waste_reason
		dataType: string
