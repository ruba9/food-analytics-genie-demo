		sourceColumn: waste_cost
		isHidden

		annotation SummarizationSetBy = Automatic

	partition 'Waste Analytics' = m
		mode: import
		source =
				let
				    Source = Databricks.Catalogs(ServerHostname, HttpPath, [Catalog=null, Database=null, EnableAutomaticProxyDiscovery=null]),
				    Catalog = Source{[Name=CatalogName,Kind="Database"]}[Data],
				    Schema = Catalog{[Name=SchemaName,Kind="Schema"]}[Data],
