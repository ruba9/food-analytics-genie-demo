model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	discourageImplicitMeasures
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_QueryOrder = ["ServerHostname","HttpPath","CatalogName","SchemaName","Sales Analytics","Dashboard KPI"]

annotation PBI_ProTooling = ["DevMode"]

ref table 'Sales Analytics'

ref table 'Dashboard KPI'
